# Copy this file to .env and fill in real values. Never commit the real .env.

# --- LLM provider (choose ONE; leave the others blank) ---
# If none is set, the pipeline still runs: eligible candidates are scored
# using a deterministic fallback and llm_status="failed" is recorded.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional overrides
# LLM_PROVIDER=gemini           # "anthropic" | "openai" | "gemini" — auto-detected from the keys above if unset
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o-mini

# --- GitHub enrichment (optional) ---
# Unauthenticated calls work fine at low volume (60 req/hr). Set a token to
# raise the rate limit to 5000/hr. Never hard-code this value in source.
GITHUB_TOKEN=
